{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`calendar.set_exception` (R-165) : jours `[from, to]` chômés\n(`ranges` vide) ou ouvrés sur les plages données.",
  "properties": {
    "cal": {
      "description": "Calendrier.",
      "oneOf": [
        {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        {
          "const": "project"
        }
      ]
    },
    "from": {
      "description": "Premier jour.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "ranges": {
      "default": [],
      "description": "Plages ouvrées `[\"08:00\",\"12:00\"]` ; vide : jours chômés.",
      "items": {
        "items": {
          "description": "Heure : 08:00 (24:00 = fin du jour).",
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "type": "string"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "type": "array"
    },
    "to": {
      "description": "Dernier jour (inclus).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    }
  },
  "required": [
    "cal",
    "from",
    "to"
  ],
  "title": "CalendarException",
  "type": "object"
}
