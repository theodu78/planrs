{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`progress.reschedule` (R-217) : replanifie le travail restant après\n`after`.",
  "properties": {
    "after": {
      "description": "Date après laquelle le reste est replanifié (défaut : date d'état\neffective, R-219).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "tasks": {
      "description": "Tâches concernées (défaut : toutes).",
      "items": {
        "description": "Tâche : UID (entier) ou étiquette \"$x\" d'une tâche créée plus tôt dans le même lot.",
        "oneOf": [
          {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          {
            "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          }
        ]
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "title": "ProgressReschedule",
  "type": "object"
}
