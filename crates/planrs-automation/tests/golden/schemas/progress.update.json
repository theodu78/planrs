        "text": {
          "description": "Texte à la manière de MS Project (« 5j », « 2d? »).",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "description": "Unité d'une durée en JSON.",
              "oneOf": [
                {
                  "const": "minute",
                  "description": "Minute.",
                  "type": "string"
                },
                {
                  "const": "hour",
                  "description": "Heure.",
                  "type": "string"
                },
                {
                  "const": "day",
                  "description": "Jour.",
                  "type": "string"
                },
                {
                  "const": "week",
                  "description": "Semaine.",
                  "type": "string"
                },
                {
                  "const": "month",
                  "description": "Mois.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Unité d'affichage."
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "task": {
      "description": "Tâche (feuille active).",
      "oneOf": [
        {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        {
          "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "task"
  ],
  "title": "ProgressUpdate",
  "type": "object"
}
