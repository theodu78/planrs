{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`progress.update` (R-216) : avancement d'une feuille. Champs absents :\ninchangés. Conflits refusés (`param.conflict`, R-202) : `percent_complete`\navec `actual_duration` ; `percent_complete` < 100 avec `actual_finish` ;\n`actual_finish` avec `remaining_duration` > 0 ; `percent_work_complete`\navec `actual_work`.",
  "properties": {
    "actual_duration": {
      "additionalProperties": false,
      "description": "Durée réelle (R-202).",
      "properties": {
        "elapsed": {
          "description": "Durée écoulée (« 5ej »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "estimated": {
          "description": "Durée estimée (« 5j? »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "minutes": {
          "description": "Minutes (ouvrées, ou écoulées si `elapsed`).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "description": "Texte à la manière de MS Project (« 5j », « 2d? »).",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "description": "Unité d'une durée en JSON.",
              "oneOf": [
                {
                  "const": "minute",
                  "description": "Minute.",
                  "type": "string"
                },
                {
                  "const": "hour",
                  "description": "Heure.",
                  "type": "string"
                },
                {
                  "const": "day",
                  "description": "Jour.",
                  "type": "string"
                },
                {
                  "const": "week",
                  "description": "Semaine.",
                  "type": "string"
                },
                {
                  "const": "month",
                  "description": "Mois.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Unité d'affichage."
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "actual_finish": {
      "description": "Fin réelle (R-202 : 100 %, durée mesurée).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "actual_start": {
      "description": "Début réel (R-202).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "actual_work": {
      "additionalProperties": false,
