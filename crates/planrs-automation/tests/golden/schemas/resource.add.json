{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`resource.add` (R-195).",
  "properties": {
    "as": {
      "description": "Étiquette `$x` de la ressource créée, pour la suite du lot.",
      "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "calendar": {
      "anyOf": [
        {
          "oneOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "enum": [
                "own",
                "project"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Calendrier (défaut : calendrier propre, O34)."
    },
    "group": {
      "description": "Groupe.",
      "type": [
        "string",
        "null"
      ]
    },
    "initials": {
      "description": "Initiales.",
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "anyOf": [
        {
          "description": "Type de ressource en JSON.",
          "oneOf": [
            {
              "const": "work",
              "description": "Travail (personne, machine).",
              "type": "string"
            },
            {
              "const": "material",
              "description": "Matérielle (consommée en quantité, étiquette d'unité).",
              "type": "string"
            },
            {
              "const": "cost",
              "description": "Coût.",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Type (défaut : travail)."
    },
    "material_label": {
      "description": "Étiquette d'unité d'une ressource matérielle (« m³ »).",
      "type": [
        "string",
        "null"
      ]
    },
    "max_units": {
      "additionalProperties": false,
      "description": "Capacité maximale (défaut 100 %, S47).",
      "properties": {
        "text": {
          "description": "Pourcentage en texte (`\"50%\"`).",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "Valeur en 1/10 000 (10 000 = 100 %).",
          "format": "int64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "name": {
      "description": "Nom.",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "ResourceAdd",
  "type": "object"
}
