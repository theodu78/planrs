{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`style.apply` : applique un modèle, une surcharge, ou revient au modèle\npar défaut des préférences (`reset`). Une entrée d'annulation par appel.",
  "properties": {
    "patch": {
      "description": "Surcharge (`StylePatch` de `planrs-render`, lue et bornée par\n`parse_doc_style` : au plus 64 Kio)."
    },
    "reset": {
      "description": "Retire le style du document (modèle par défaut des préférences ;\nplus rien d'écrit dans le fichier).",
      "type": "boolean"
    },
    "template": {
      "anyOf": [
        {
          "description": "Modèle de mise en forme intégré, en JSON.",
          "oneOf": [
            {
              "const": "classique",
              "description": "Apparence de J7.",
              "type": "string"
            },
            {
              "const": "sobre",
              "description": "Sobre.",
              "type": "string"
            },
            {
              "const": "contraste_eleve",
              "description": "Contraste élevé.",
              "type": "string"
            },
            {
              "const": "presentation",
              "description": "Présentation client.",
              "type": "string"
            },
            {
              "const": "chantier",
              "description": "Chantier.",
              "type": "string"
            },
            {
              "const": "impression_nb",
              "description": "Impression noir et blanc.",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Modèle de base."
    }
  },
  "title": "StyleApply",
  "type": "object"
}
