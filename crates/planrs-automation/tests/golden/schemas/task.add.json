{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`task.add`.",
  "properties": {
    "as": {
      "description": "Étiquette `$x` de la tâche créée, pour la suite du lot (R-150).",
      "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "at": {
      "anyOf": [
        {
          "description": "Placement d'une tâche ajoutée ou déplacée (R-152, R-154).",
          "oneOf": [
            {
              "const": "end",
              "description": "En dernière position, niveau 1.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Après le sous-arbre de la tâche, au même niveau.",
              "properties": {
                "after": {
                  "description": "Tâche : UID (entier) ou étiquette \"$x\" d'une tâche créée plus tôt dans le même lot.",
                  "oneOf": [
                    {
                      "maximum": 4294967295,
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "after"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Juste avant la tâche, au même niveau.",
              "properties": {
                "before": {
                  "description": "Tâche : UID (entier) ou étiquette \"$x\" d'une tâche créée plus tôt dans le même lot.",
                  "oneOf": [
                    {
                      "maximum": 4294967295,
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "before"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Premier enfant de la tâche.",
              "properties": {
                "first_child_of": {
                  "description": "Tâche : UID (entier) ou étiquette \"$x\" d'une tâche créée plus tôt dans le même lot.",
                  "oneOf": [
                    {
                      "maximum": 4294967295,
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "first_child_of"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Dernier enfant de la tâche.",
              "properties": {
                "last_child_of": {
                  "description": "Tâche : UID (entier) ou étiquette \"$x\" d'une tâche créée plus tôt dans le même lot.",
                  "oneOf": [
                    {
                      "maximum": 4294967295,
                      "minimum": 1,
                      "type": "integer"
                    },
                    {
                      "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "last_child_of"
              ],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Placement (défaut : fin)."
    },
    "duration": {
      "additionalProperties": false,
      "description": "Durée (défaut : celle du projet, estimée).",
      "properties": {
        "elapsed": {
          "description": "Durée écoulée (« 5ej »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "estimated": {
          "description": "Durée estimée (« 5j? »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "minutes": {
          "description": "Minutes (ouvrées, ou écoulées si `elapsed`).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "description": "Texte à la manière de MS Project (« 5j », « 2d? »).",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "description": "Unité d'une durée en JSON.",
              "oneOf": [
                {
                  "const": "minute",
                  "description": "Minute.",
                  "type": "string"
                },
                {
                  "const": "hour",
                  "description": "Heure.",
                  "type": "string"
                },
                {
                  "const": "day",
                  "description": "Jour.",
                  "type": "string"
                },
                {
                  "const": "week",
                  "description": "Semaine.",
                  "type": "string"
                },
                {
                  "const": "month",
                  "description": "Mois.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Unité d'affichage."
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "finish": {
      "description": "Fin saisie (→ contrainte, R-158).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "milestone": {
      "description": "Jalon.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "name": {
      "description": "Nom.",
      "type": "string"
    },
    "notes": {
      "description": "Notes.",
      "type": [
        "string",
        "null"
      ]
    },
    "start": {
      "description": "Début saisi (→ contrainte, R-158).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name"
  ],
  "title": "TaskAdd",
  "type": "object"
}
