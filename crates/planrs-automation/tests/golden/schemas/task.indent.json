{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Commande à une seule tâche (`task.indent`, `task.outdent`).",
  "properties": {
    "uid": {
      "description": "Tâche.",
      "oneOf": [
        {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        {
          "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "uid"
  ],
  "title": "TaskOne",
  "type": "object"
}
