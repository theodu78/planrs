{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`task.update`.",
  "properties": {
    "active": {
      "description": "Tâche active.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "custom": {
      "additionalProperties": true,
      "description": "Champs personnalisés (R-264, seconde passe UX) : clé `text1` …\n`text30`, `number1` … `number20`, `date1` … `date10`, `flag1` …\n`flag20` ; valeur : texte (≤ 255 caractères) ; nombre en texte dans\nla langue du lot (« 12,5 » ou « 12.5 ») ou nombre JSON ; date ISO\nlocale comme `start` (« 2026-11-02T08:00 ») ; booléen ; `null`\nefface. Aucune date calculée.",
      "type": "object"
    },
    "duration": {
      "additionalProperties": false,
      "description": "Durée.",
      "properties": {
        "elapsed": {
          "description": "Durée écoulée (« 5ej »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "estimated": {
          "description": "Durée estimée (« 5j? »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "minutes": {
          "description": "Minutes (ouvrées, ou écoulées si `elapsed`).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "description": "Texte à la manière de MS Project (« 5j », « 2d? »).",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "description": "Unité d'une durée en JSON.",
              "oneOf": [
                {
                  "const": "minute",
                  "description": "Minute.",
                  "type": "string"
                },
                {
                  "const": "hour",
                  "description": "Heure.",
                  "type": "string"
                },
                {
                  "const": "day",
                  "description": "Jour.",
                  "type": "string"
                },
                {
                  "const": "week",
                  "description": "Semaine.",
                  "type": "string"
                },
                {
                  "const": "month",
                  "description": "Mois.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Unité d'affichage."
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "effort_driven": {
      "description": "Pilotée par l'effort (R-190 à R-193, R-197 ; J5, refusé jusqu'au lot\nL7).",
      "type": [
        "boolean",
        "null"
      ]
    },
    "finish": {
      "description": "Fin saisie (R-158).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "milestone": {
      "description": "Jalon.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "mode": {
      "anyOf": [
        {
          "description": "Mode de planification d'une tâche en JSON (J8, R-253).",
          "oneOf": [
            {
              "const": "auto",
              "description": "Planification automatique.",
              "type": "string"
            },
            {
              "const": "manual",
              "description": "Planification manuelle (dates figées, S73).",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Mode de planification (J8, R-253) : vers manuel, dates planifiées\ncourantes figées ; vers automatique, valeurs manuelles retirées.\nSur une feuille manuelle, `start`, `finish` et `duration` écrivent\nles valeurs manuelles, sans contrainte (R-254)."
    },
    "name": {
      "description": "Nom (`null` refusé).",
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "description": "Notes.",
      "type": [
        "string",
        "null"
      ]
    },
    "start": {
      "description": "Début saisi (R-158).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:00)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "anyOf": [
        {
          "description": "Type de tâche en JSON (S41).",
          "oneOf": [
            {
              "const": "fixed_units",
              "description": "Unités fixes.",
              "type": "string"
            },
            {
              "const": "fixed_duration",
              "description": "Durée fixe.",
              "type": "string"
            },
            {
              "const": "fixed_work",
              "description": "Travail fixe (toujours piloté par l'effort).",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Type de tâche (R-189, R-197 ; J5, refusé `command.not_yet_available`\njusqu'au lot L7)."
    },
    "uid": {
      "description": "Tâche.",
      "oneOf": [
        {
          "maximum": 4294967295,
          "minimum": 1,
          "type": "integer"
        },
        {
          "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        }
      ]
    },
    "work": {
      "additionalProperties": false,
      "description": "Travail total (R-189, R-197 ; `param.conflict` avec `duration` ; J5,\nrefusé jusqu'au lot L7).",
      "properties": {
        "elapsed": {
          "description": "Durée écoulée (« 5ej »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "estimated": {
          "description": "Durée estimée (« 5j? »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "minutes": {
          "description": "Minutes (ouvrées, ou écoulées si `elapsed`).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "description": "Texte à la manière de MS Project (« 5j », « 2d? »).",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "description": "Unité d'une durée en JSON.",
              "oneOf": [
                {
                  "const": "minute",
                  "description": "Minute.",
                  "type": "string"
                },
                {
                  "const": "hour",
                  "description": "Heure.",
                  "type": "string"
                },
                {
                  "const": "day",
                  "description": "Jour.",
                  "type": "string"
                },
                {
                  "const": "week",
                  "description": "Semaine.",
                  "type": "string"
                },
                {
                  "const": "month",
                  "description": "Mois.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Unité d'affichage."
        }
      },
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "uid"
  ],
  "title": "TaskUpdate",
  "type": "object"
}
